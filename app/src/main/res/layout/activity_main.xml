<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="20dp"
    tools:context=".MainActivity">

    <!-- 1. Logo da marca GameZone -->
    <ImageView
        android:id="@+id/iv_logo_gamezone"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/gamezone_logo_desc"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_gamezone_logo" />

    <!-- 2. Capa do jogo (Far Cry 5 oficial) -->
    <ImageView
        android:id="@+id/iv_game_cover"
        android:layout_width="150dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        android:background="@color/card_bg"
        android:contentDescription="@string/game_cover_desc"
        android:elevation="4dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_logo_gamezone"
        app:srcCompat="@drawable/far_cry_5" />

    <!-- Imagem menor (selo de classificação etária), posicionada em relação à capa -->
    <ImageView
        android:id="@+id/iv_rating_seal"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/age_rating_desc"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="@id/iv_game_cover"
        app:layout_constraintEnd_toEndOf="@id/iv_game_cover"
        app:srcCompat="@drawable/ic_rating_18" />

    <!-- 3. Texto (nome do jogo) -->
    <TextView
        android:id="@+id/tv_game_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/game_name"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_game_cover" />

    <!-- Título para as opções de plataforma -->
    <TextView
        android:id="@+id/tv_platform_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/select_platform"
        android:textColor="@color/neon_cyan"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_game_title" />

    <!-- 4. RadioGroup com 3 RadioButton: PC, PlayStation, Xbox -->
    <RadioGroup
        android:id="@+id/rg_platforms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_platform_label">

        <RadioButton
            android:id="@+id/rb_pc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/neon_pink"
            android:checked="true"
            android:text="@string/platform_pc"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rb_playstation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/neon_pink"
            android:text="@string/platform_playstation"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rb_xbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/neon_pink"
            android:text="@string/platform_xbox"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </RadioGroup>

    <!-- 5. CheckBox: "Receber notificações de promoções" - isolado no canto inferior direito -->
    <CheckBox
        android:id="@+id/cb_notifications"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/neon_cyan"
        android:text="@string/promo_notifications"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cadastre-se"
        tools:layout_editor_absoluteX="119dp"
        tools:layout_editor_absoluteY="584dp" />

</androidx.constraintlayout.widget.ConstraintLayout>